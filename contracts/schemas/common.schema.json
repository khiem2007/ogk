{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://ogk.example/contracts/v1/common.schema.json",
    "$defs": {
        "uuid": {
            "type": "string",
            "format": "uuid"
        },
        "date_time": {
            "type": "string",
            "format": "date-time"
        },
        "local_date": {
            "type": "string",
            "format": "date"
        },
        "windows_sid": {
            "type": "string",
            "pattern": "^S-1-(?:[0-9]+-)*[0-9]+$"
        },
        "category": {
            "type": "string",
            "enum": [
                "education",
                "entertainment",
                "games",
                "other"
            ]
        },
        "domain": {
            "type": "string",
            "maxLength": 253,
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$"
        },
        "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
        }
    }
}