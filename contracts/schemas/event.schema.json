{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://ogk.example/contracts/v1/event.schema.json",
    "title": "OGK agent event envelope v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema_version",
        "event_id",
        "boot_id",
        "sequence",
        "observed_at",
        "event_type",
        "payload"
    ],
    "properties": {
        "schema_version": {
            "const": 1
        },
        "event_id": {
            "$ref": "common.schema.json#/$defs/uuid"
        },
        "boot_id": {
            "$ref": "common.schema.json#/$defs/uuid"
        },
        "sequence": {
            "type": "integer",
            "minimum": 0
        },
        "observed_at": {
            "$ref": "common.schema.json#/$defs/date_time"
        },
        "event_type": {
            "type": "string",
            "enum": [
                "usage.interval",
                "app.blocked",
                "domain.blocked",
                "telemetry.gap"
            ]
        },
        "payload": {
            "type": "object"
        }
    },
    "allOf": [
        {
            "if": {
                "properties": {
                    "event_type": {
                        "const": "usage.interval"
                    }
                },
                "required": [
                    "event_type"
                ]
            },
            "then": {
                "properties": {
                    "payload": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "started_at",
                            "ended_at",
                            "active_seconds",
                            "telemetry_quality"
                        ],
                        "properties": {
                            "started_at": {
                                "$ref": "common.schema.json#/$defs/date_time"
                            },
                            "ended_at": {
                                "$ref": "common.schema.json#/$defs/date_time"
                            },
                            "active_seconds": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 86400
                            },
                            "app_id": {
                                "$ref": "common.schema.json#/$defs/uuid"
                            },
                            "category": {
                                "$ref": "common.schema.json#/$defs/category"
                            },
                            "telemetry_quality": {
                                "type": "string",
                                "enum": [
                                    "measured",
                                    "estimated"
                                ]
                            }
                        }
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "event_type": {
                        "enum": [
                            "app.blocked",
                            "domain.blocked"
                        ]
                    }
                },
                "required": [
                    "event_type"
                ]
            },
            "then": {
                "properties": {
                    "payload": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "rule_id",
                            "reason_code",
                            "subject_type"
                        ],
                        "properties": {
                            "rule_id": {
                                "$ref": "common.schema.json#/$defs/uuid"
                            },
                            "reason_code": {
                                "type": "string",
                                "enum": [
                                    "APP_BLOCKED",
                                    "DOMAIN_BLOCKED"
                                ]
                            },
                            "subject_type": {
                                "type": "string",
                                "enum": [
                                    "app",
                                    "domain"
                                ]
                            },
                            "category": {
                                "$ref": "common.schema.json#/$defs/category"
                            }
                        }
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "event_type": {
                        "const": "telemetry.gap"
                    }
                },
                "required": [
                    "event_type"
                ]
            },
            "then": {
                "properties": {
                    "payload": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "started_at",
                            "ended_at",
                            "reason_code"
                        ],
                        "properties": {
                            "started_at": {
                                "$ref": "common.schema.json#/$defs/date_time"
                            },
                            "ended_at": {
                                "$ref": "common.schema.json#/$defs/date_time"
                            },
                            "reason_code": {
                                "type": "string",
                                "enum": [
                                    "HELPER_UNAVAILABLE",
                                    "SESSION_UNKNOWN",
                                    "CLOCK_SUSPECT",
                                    "SLEEP_GAP"
                                ]
                            }
                        }
                    }
                }
            }
        }
    ]
}